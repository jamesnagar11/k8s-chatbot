# pyenv
#   For a library or app, you might want to share your .python-version.
#   If so, comment this line.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library rather than an application, you might skip it.
# Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds.
#   Like pipenv, you generally want to commit this for apps, but maybe not libraries.
# poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
.pdm-plugins/

